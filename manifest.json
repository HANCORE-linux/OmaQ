{
  "schemaVersion": 1,
  "id": "hancore.omaq",
  "name": "OmaQ",
  "version": "0.7.0",
  "author": "hancore",
  "license": "MIT AND CC-BY-SA-4.0 AND CC-BY-4.0 AND CC0-1.0 AND LicenseRef-Pixabay-Content",
  "description": "Invite-only 1:1 and group chat for the Omarchy bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaQ",
    "description": "OmaQ chat",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "notifyBadge": true,
      "notifyRightPanel": false,
      "notifyDesktop": false,
      "surfaceMode": "separate",
      "sound": "icq-message",
      "soundCustomPath": "",
      "chatTheme": "system",
      "messageScale": 1.0,
      "animateUnread": true,
      "formatToolbar": false
    },
    "schema": [
      { "key": "notifyBadge", "type": "boolean", "label": "Badge", "defaultValue": true },
      { "key": "notifyRightPanel", "type": "boolean", "label": "Right panel", "defaultValue": false },
      { "key": "notifyDesktop", "type": "boolean", "label": "Desktop notification", "defaultValue": false },
      { "key": "surfaceMode", "type": "enum", "label": "Cards", "options": ["separate", "bundled"], "defaultValue": "separate" },
      { "key": "sound", "type": "enum", "label": "Sound", "options": ["off", "icq-message", "qq", "wechat", "skype", "msn", "aurora", "crystal", "ripple", "glow", "halo", "click", "pop", "bell", "soft", "knock", "custom"], "defaultValue": "icq-message" },
      { "key": "soundCustomPath", "type": "path", "label": "Custom sound", "defaultValue": "" },
      { "key": "chatTheme", "type": "enum", "label": "Chat theme", "options": ["system", "gruvbox", "rose-pine", "everforest", "gruvbox-light", "catppuccin-latte", "tokyo-night-light"], "defaultValue": "system" },
      { "key": "messageScale", "type": "enum", "label": "Chat message scale", "options": [0.9, 1.0, 1.1, 1.2, 1.4], "defaultValue": 1.0 },
      { "key": "animateUnread", "type": "boolean", "label": "Unread motion", "defaultValue": true },
      { "key": "formatToolbar", "type": "boolean", "label": "Formatting toolbar", "defaultValue": false }
    ]
  }
}
